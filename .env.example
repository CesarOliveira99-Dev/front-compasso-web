BACKEND_URL=http://127.0.0.1:4000/v1

# Opcional: chave Google Maps Embed API, restrita aos domínios do frontend.
GOOGLE_MAPS_EMBED_KEY=

# Opcional: Geocoding API para identificar a cidade após autorização de localização.
# Chave privada, exclusiva do servidor. Restrinja à Geocoding API e configure quota no Google.
GOOGLE_GEOCODING_API_KEY=
# Mesmo segredo privado configurado na API; mínimo 32 caracteres, ideal 32 bytes aleatórios.
# Obrigatório no frontend em produção. Não usar prefixo NEXT_PUBLIC_.
BFF_PROXY_SECRET=
